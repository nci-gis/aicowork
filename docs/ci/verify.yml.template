# CI template for the public kernel repo (GitHub Actions syntax).
# NOT ACTIVE. Before enabling:
#   1. pin every `uses:` to a full commit SHA you have verified yourself
#      (tags can be moved; SHAs cannot) — this template deliberately does not
#      ship SHAs it could not verify;
#   2. keep `permissions:` at read-only; add `id-token: write` only for a
#      signed-provenance job.
name: verify
on: [push, pull_request]
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@<VERIFIED_SHA>
      - uses: astral-sh/setup-uv@<VERIFIED_SHA>
      - run: uv sync --locked --project 98_tools
      - run: uv run --locked --project 98_tools aicowork verify
      - run: uv run --locked --project 98_tools aicowork sbom --out dist/sbom.cdx.json
      - run: uvx pip-audit -r <(uv export --project 98_tools --no-hashes) || true   # advisory until triaged
      # release zips are built by the owner, locally: `devkit package` needs the owner's private
      # instance for its deny-list, which never goes to CI
      # uv audit (preview in 2026) may replace pip-audit once stable
